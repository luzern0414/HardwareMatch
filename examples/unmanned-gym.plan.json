  "flows": [
    {
      "name": "刷脸或动态码入场",
      "steps": [
        {
          "trigger": "会员在 A 门外刷脸或出示小程序动态码",
          "devices": [
            "face_a"
          ],
          "protocol": "本地识别",
          "action": "一体机识别人脸或读取码串",
          "short": "刷脸 / 扫码"
        },
        {
          "trigger": "识别完成",
          "devices": [
            "face_a",
            "gw"
          ],
          "protocol": "ISAPI 事件推送",
          "action": "网关收到会员标识或码串",
          "short": "上报网关"
        },
        {
          "trigger": "网关转发",
          "devices": [
            "gw",
            "mqtt",
            "api"
          ],
          "protocol": "MQTT over TLS",
          "action": "云端校验：码签名与时效、卡状态、时段、门店容量、本人不在场；通过则扣次并下发放行",
          "short": "云端校验资格"
        },
        {
          "trigger": "放行指令",
          "devices": [
            "gw",
            "ctrl",
            "lock_a"
          ],
          "protocol": "微耕 TCP → 继电器",
          "action": "控制器打开 A 门，1 秒内完成",
          "short": "A 门打开"
        },
        {
          "trigger": "拒绝",
          "devices": [
            "face_a",
            "speaker"
          ],
          "protocol": "ISAPI / SIP 广播",
          "action": "屏幕与语音提示具体原因（卡过期、满员、已在场）",
          "short": "不通过时语音提示原因"
        }
      ]
    },
    {
      "name": "AB 门防尾随",
      "steps": [
        {
          "trigger": "A 门关闭",
          "devices": [
            "lock_a",
            "ctrl"
          ],
          "protocol": "门状态干接点",
          "action": "控制器确认 A 门关好后才允许 B 门动作",
          "short": "A 门关好"
        },
        {
          "trigger": "缓冲区计数",
          "devices": [
            "counter"
          ],
          "protocol": "本地算法",
          "action": "统计缓冲区人数",
          "short": "缓冲区计数"
        },
        {
          "trigger": "人数大于 1",
          "devices": [
            "counter",
            "ctrl",
            "speaker",
            "gw"
          ],
          "protocol": "报警干接点 / ISAPI",
          "action": "闭锁 B 门，语音提示“请逐一核验”，告警推送并附抓拍",
          "short": "多于 1 人：闭锁 B 门并告警"
        },
        {
          "trigger": "仅 1 人且 B 门内核验通过",
          "devices": [
            "face_b",
            "ctrl",
            "lock_b"
          ],
          "protocol": "韦根 → 继电器",
          "action": "打开 B 门，记录入场",
          "short": "1 人：B 门核验开门"
        }
      ]
    },
    {
      "name": "离场与超时未离场",
      "steps": [
        {
          "trigger": "会员按出门按钮",
          "devices": [
            "exit_btn",
            "ctrl"
          ],
          "protocol": "干接点",
          "action": "本地开门，断网也可出",
          "short": "按出门按钮开门"
        },
        {
          "trigger": "客流相机出方向计数",
          "devices": [
            "counter",
            "nvr",
            "gw"
          ],
          "protocol": "ISAPI 事件",
